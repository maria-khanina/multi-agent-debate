{
  "models": {
    "researcher": {
      "provider": "gemini",
      "llm": "models/gemini-2.5-flash-lite",
      "temperature": 0.0
    },
    "approver": {
      "provider": "gemini",
      "llm": "models/gemini-3.1-flash-lite",
      "temperature": 0.0
    },
    "debater": {
      "provider": "gemini",
      "llm": "models/gemma-4-26b-a4b-it",
      "temperature": 0.4
    },
    "judge": {
      "provider": "gemini",
      "llm": "models/gemma-4-31b-it",
      "temperature": 0.0
    }
  },
  "embedding": {
    "provider": "ollama",
    "model": "nomic-embed-text",
    "truncation_length": 8000,
    "parent_chunk_size": 2000,
    "parent_chunk_overlap": 0,
    "child_chunk_size": 400,
    "child_chunk_overlap": 50
  },
  "search": {
    "papers_per_search": 3,
    "max_tries": 3,
    "max_knowledge_base": 2
  },
  "agents": {
    "pro_stance": "PRO",
    "against_stance": "AGAINST"
  },
  "database": {
    "path": "./debate_vectors",
    "redis_url": "redis://localhost:6379/0"
  },
  "prompts": {
    "research_init": [
      "You search for scientific papers that will help to win in the debate.",
      "Debate: {motion}",
      "Stance: {stance}",
      "You have {max_tries} attempts to search for papers.",
      "Output EXACTLY ONE short search query.",
      "Do not include quotes or conversational text."
    ],
    "research_middle": [
      "Result: {approved} papers approved and saved.",
      "Attempts left: {attempts_left}.",
      "Output your next DISTINCT search query."
    ],
    "opening": [
      "You are a debater.",
      "Motion: {motion}.",
      "Your Stance: {stance}.",
      "Rule: Write a strong, one-paragraph opening statement",
      "laying out your core argument."
    ],
    "debator": [
      "You are a debater.",
      "Motion: {motion}",
      "Your Stance: {stance}",
      "Rules:",
      "1. Read the transcript.",
      "2. Directly attack the last point made by opponent.",
      "3. Provide one strong piece of evidence for stance.",
      "4. Do not repeat previous arguments.",
      "5. Keep answer strictly to one short paragraph.",
      "6. Write organically, with no headers.",
      "",
      "Transcript:",
      "{transcript}",
      "",
      "Your Argument:"
    ],
    "judge": [
      "You are a debate judge.",
      "Motion: {motion}",
      "",
      "Rules:",
      "1. Read the transcript below.",
      "2. Evaluate who won:",
      "    - Penalize debaters who change the subject.",
      "    - Penalize debaters who repeat the same point.",
      "    - Reward debaters who dismantle logic.",
      "    - Reward logical consistancy, clarity.",
      "3. Keep your verdict strictly to one paragraph.",
      "",
      "Transcript:",
      "{transcript}",
      "",
      "Your Verdict:"
    ],
    "paper_approver_prompt": [
      "Evaluate this academic paper.",
      "Title: {title}",
      "Year: {year}",
      "Citations: {citations}",
      "Affiliations: {affiliations}",
      "Abstract: {abstract}",
      "",
      "Criteria:",
      "1. Impact: Citation count sufficient?",
      "2. Methodological Rigor: verifiable findings?",
      "3. Reject papers that rely on vague adjectives.",
      "4. Trust: Institutions recognized?",
      "",
      "Output EXACTLY ONE WORD: PASS or FAIL."
    ],
    "paper_approver_pass_word": "PASS"
  }
}